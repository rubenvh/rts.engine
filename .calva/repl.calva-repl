clj꞉rts.application.commands꞉> (defn in-bounds? [position width height]
                                 (and (<= 0 (first position)) (< (first position) width)
                                      (<= 0 (second position)) (< (second position) height)))

(in-bounds? [2 1] 3 2)
(defn in-bounds? [position width height]
	(and (<= 0 (first position)) (< (first position) width)
      (<= 0 (second position)) (< (second position) height)))
