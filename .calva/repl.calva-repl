; This is the Calva REPL Window.
; It's just a file, really, with some special treatment from Calva.
; Use it as a REPL input prompt if you like. (When the REPL is connected.)
; TIPS: The keyboard shortcut `ctrl+alt+o r` shows and focuses this window
; Please see https://calva.io/repl-window/ for more info.
; Happy coding! ♥️

; TIPS: As with any Clojure file when the REPL is connected:
; - `alt+enter` evaluates the current top level form.
; - `ctrl+enter` evaluates the current form.
; Special for this file:
; - `alt+up` and `alt+down` traverse up and down the REPL command history
;    when the cursor is after the last contents at the prompt
; 
; See also the Calva Inspector: https://calva.io/inspector/

(when-let [requires (resolve 'clojure.main/repl-requires)] (clojure.core/apply clojure.core/require @requires))
clj꞉user꞉> 
(defn evolve [state event]
  (case (:type event)
    :unit-spawned
    (assoc-in state [:units (:unit-id event)] {:type (:unit-type event) :position (:position event)})
    :unit-moved
    (assoc-in state [:units (:unit-id event) :position] (:position event))
    state))
clj꞉rts.domain.state꞉> 
(reduce evolve {:units {}}
        [{:type :unit-spawned :unit-id 1 :unit-type :worker :position [2 3]}
         {:type :unit-moved :unit-id 1 :position [4 5]}])
